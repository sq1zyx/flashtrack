# ===== Нейросеть =====
# gigachat — GigaChat от Сбера (есть бесплатный лимит для физлиц)
# anthropic — Claude (нужен платный ключ Anthropic)
LLM_PROVIDER=gigachat

# Ключ авторизации GigaChat: developers.sber.ru → ваш проект GigaChat API → «Ключ авторизации»
GIGACHAT_AUTH_KEY=
# Для физлиц и самозанятых — GIGACHAT_API_PERS; для ИП и компаний — GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2 (бесплатный лимит обычно на неё), GigaChat-2-Pro или GigaChat-2-Max (точнее, но платно)
GIGACHAT_MODEL=GigaChat-2

# Только для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Сервис =====
PORT=3000
# Пароль для /api/admin/* (минимум 16 символов). Можно не заполнять: коды выдаются через new-code.bat
ADMIN_TOKEN=
DATA_DIR=data
# Через сколько дней удалять отчёты (в них текст договоров) — это обещано в политике ПДн
RETENTION_DAYS=30
PII_MASKING=true

# ===== Лимиты =====
MAX_FILE_MB=20
MAX_PDF_PAGES=300
MAX_OCR_PAGES=40

# ===== Тонкая настройка (обычно не нужна) =====
# AUDIT_EFFORT=medium
# SINGLE_PASS_MAX_TOKENS=24000
# CHUNK_TARGET_TOKENS=12000
# JOB_CONCURRENCY=1
# OCR_LANGS=rus+eng
# OCR_CACHE_PATH=.ocr-cache
