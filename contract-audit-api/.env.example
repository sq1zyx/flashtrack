ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# Модель и глубина анализа
ANTHROPIC_MODEL=claude-sonnet-5-5
AUDIT_EFFORT=medium          # low | medium | high | xhigh | max
AUDIT_DEEP_EFFORT=high       # для запросов с deep=true
ANTHROPIC_USE_FALLBACKS=true # серверный fallback при отказе фильтров безопасности (только Claude API)

# Разбивка длинных договоров
SINGLE_PASS_MAX_TOKENS=150000
CHUNK_TARGET_TOKENS=40000

# Лимиты
MAX_FILE_MB=20
MAX_PDF_PAGES=300
MAX_OCR_PAGES=40

# OCR: языки tesseract и где хранить *.traineddata (скачиваются при первом запуске)
OCR_LANGS=rus+eng
OCR_CACHE_PATH=.ocr-cache
# OCR_LANG_PATH=/opt/tessdata   # для серверов без интернета
