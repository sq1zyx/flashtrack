{
  "name": "contract-audit-api",
  "version": "0.1.0",
  "description": "Contract audit API: file upload -> text extraction/OCR -> Claude audit -> validated JSON",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "bash scripts/make-fixtures.sh",
    "code": "tsx --disable-warning=ExperimentalWarning src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "node-html-parser": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
