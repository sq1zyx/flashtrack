# Адрес, где открыт сайт (без / в конце). На него вернут покупателя после оплаты.
SITE_URL=https://tweakmacro.example.com
PORT=8080

# Stripe — оплата в долларах (карты не из РФ). Ключи: dashboard.stripe.com → Developers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ЮKassa — оплата в рублях. Ключи: yookassa.ru → Интеграция → Ключи API.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 = отправлять чеки по 54-ФЗ через ЮKassa (нужно, если продаёшь как ИП/самозанятый с онлайн-кассой ЮKassa)
YOOKASSA_RECEIPTS=0
# Код НДС для чека: 1 — без НДС
YOOKASSA_VAT_CODE=1

# Resend — письмо с ключом покупателю (необязательно). resend.com → API Keys.
RESEND_API_KEY=
MAIL_FROM=TweakMacro <keys@tweakmacro.example.com>

# Пароль для админских запросов (выдать ключ вручную, сбросить привязку к ПК)
ADMIN_TOKEN=change-me-to-long-random-string

# Сколько ПК можно привязать к одному ключу
MAX_DEVICES=1

# 1 = тестовая оплата без денег (только для проверки на своём компьютере!)
DEV_FAKE_PAY=0

# Папка с файлами программы для автообновления в лаунчере (по умолчанию ../macros)
APP_DIR=
# Как часто пользователь может сам перенести ключ на новый ПК (дней)
TRANSFER_COOLDOWN_DAYS=7
